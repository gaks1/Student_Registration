<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RegistrationApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Usiu">

        <activity
            android:name=".RegistrationActivity"
            android:exported="true"
            android:label="@string/title_registration">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:label="@string/title_library" />

        <activity
            android:name=".HostelActivity"
            android:exported="false"
            android:label="@string/title_hostel" />

        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:label="@string/title_payment" />

        <activity
            android:name=".SummaryActivity"
            android:exported="false"
            android:label="@string/title_summary" />
    </application>
</manifest>
