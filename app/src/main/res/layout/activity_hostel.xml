<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".HostelActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvHostelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hostel_header"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvHostelSubHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hostel_sub_header"
            android:textSize="13sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- i. Hostel Location (Select drop down) -->
                <TextView
                    android:id="@+id/tvHostelLocationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_hostel_location"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spHostelLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- ii. Room Type (bedsitter, 1 bedroom, etc) -->
                <TextView
                    android:id="@+id/tvRoomTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_room_type"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- iii. Whether sharable or not (Radio Group) -->
                <TextView
                    android:id="@+id/tvSharableLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_sharable"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgSharable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbSharable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sharable_yes" />

                    <RadioButton
                        android:id="@+id/rbNotSharable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sharable_no" />
                </RadioGroup>

                <!-- iv. Student IDNo (to be entered) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStudentIdNo"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_student_idno"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStudentIdNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnClearHostel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_form"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSaveHostel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_save_hostel"
                        android:backgroundTint="#1976D2"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
